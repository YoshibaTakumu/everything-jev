{
  "name": "everything-jev",
  "version": "0.1.0",
  "description": "Typed Jev decisions, executable recipes, and integration guides for automation harnesses.",
  "type": "module",
  "license": "MIT",
  "author": "everything-jev contributors",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.5.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "everything-jev": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YoshibaTakumu/everything-jev.git"
  },
  "bugs": {
    "url": "https://github.com/YoshibaTakumu/everything-jev/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "oxlint --deny-warnings src test examples",
    "lint:fix": "pnpm lint --fix",
    "verify": "pnpm format:check && pnpm lint && pnpm test",
    "jev": "node dist/cli.js",
    "demo": "pnpm build && node dist/cli.js demo all",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2"
  }
}
